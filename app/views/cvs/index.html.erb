<div class="page-container">
  <h1><%= @cv.name %></h1>

  <p><%= @cv.summary %></p>

  <p>
    <% @cv.tags.each do |tag| %>
      <span class="tag"><%= tag.name %></span>
    <% end %>
  </p>

  <% @cv.sections.each do |section| %>
    <h3><%= section.title %></h3>

    <% section.entries.each do |entry| %>
      <h4 class="job-header">
        <span><%= entry.title %></span>
        <span class="job-date"><%= entry.date_text %></span>
      </h4>

      <% if entry.meta.present? %>
        <p class="job-meta"><%= entry.meta %></p>
      <% end %>

      <% if entry.blurb.present? %>
        <p><%= entry.blurb %></p>
      <% end %>

      <% if entry.subtitle.present? %>
        <p>
          <%= entry.subtitle %>
          <% if entry.tags.any? %>
            <% entry.tags.each do |tag| %>
              <span class="tag-sm"><%= tag.name %></span>
            <% end %>
          <% end %>
        </p>
      <% end %>

      <% if entry.bullets.any? %>
        <ul>
          <% entry.bullets.each do |bullet| %>
            <li>
              <%= bullet.description %>
              <% bullet.tags.each do |tag| %>
                <span class="tag-sm"><%= tag.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>

  <% if @cv.email == "nathanjordaan@gmail.com" %>
    <h3>Contact</h3>
    <p class="contact-links">
      <%= link_to new_contact_path do %>
        <%= icon "send", height: 16, width: 16, class: "contact-icon" %>
        Contact me
      <% end %>
      <%= link_to "mailto:#{@cv.email}" do %>
        <%= icon "mail", height: 16, width: 16, class: "contact-icon" %>
        <%= @cv.email %>
      <% end %>

      <% if @cv.github_url.present? %>
        <%= link_to @cv.github_url, target: :blank do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="contact-icon"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          <%= @cv.github_url.sub("https://github.com/", "") %>
        <% end %>
      <% end %>
      <%= link_to cv_pdf_path do %>
        <%= icon "download", height: 16, width: 16, class: "contact-icon" %>
        View as PDF
      <% end %>
    </p>
  <% end %>
</div>
