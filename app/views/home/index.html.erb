<div class="page-container">
  <h1>Nathan Jordaan</h1>
  <p>Welcome to my very humble website, it's really only for my CV.</p>

  <div>
    <h2>I am...</h2>
    <ul>
      <li>
        <!-- Helper method demo: years_between -->
        <%= years_between(Date.parse("1993-09-03"), Date.today) %>
        years old,
      </li>
      <li>happily married to Shay,</li>
      <li>a serious christian,</li>
      <li>a full-stack developer,</li>
      <li>and proudly South African.</li>
    </ul>
  </div>

  <div>
    <%= link_to cv_index_path do %>
      <%= icon "file-text", height: 16, width: 16, class: "contact-icon" %>
      See my CV
    <% end %>
    <% if authenticated? %>
      <%= link_to edit_cv_path do %>
        <%= icon "pencil", height: 16, width: 16, class: "contact-icon" %>
        Edit my CV
      <% end %>
      <%= link_to session_path, data: { turbo_method: :delete } do %>
        <%= icon "log-out", height: 16, width: 16, class: "contact-icon" %>
        Sign out
      <% end %>
    <% end %>
  </div>
</div>
