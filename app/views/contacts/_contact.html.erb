<div id="<%= dom_id contact %>">
  <div>
    <strong>Full name:</strong>
    <%= contact.full_name %>
  </div>

  <div>
    <strong>Company name:</strong>
    <%= contact.company_name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= contact.email %>
  </div>

  <div>
    <strong>Message:</strong>
    <%= contact.message %>
  </div>

</div>
