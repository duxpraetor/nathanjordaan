<div class="page-container">
  <h1>New Entry</h1>
  <%= form_with model: [@section, @entry] do |f| %>
    <p><%= f.label :title, "Company / Institution / Project" %><br><%= f.text_field :title %></p>
    <p><%= f.label :subtitle %><br><%= f.text_field :subtitle %></p>
    <p><%= f.label :date_text %><br><%= f.text_field :date_text %></p>
    <p><%= f.label :meta %><br><%= f.text_field :meta %></p>
    <p><%= f.label :blurb %><br><%= f.text_area :blurb, rows: 3 %></p>
    <p><%= f.label :display_order %><br><%= f.number_field :display_order %></p>
    <p><%= f.label :tag_list, "Tags (comma separated)" %><br><%= f.text_field :tag_list %></p>
    <p><%= f.submit "Create Entry" %></p>
  <% end %>
  <p><%= link_to "Back", edit_cv_path %></p>
</div>
